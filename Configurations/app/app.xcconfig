// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

//Packaging
PRODUCT_BUNDLE_IDENTIFIER = $(APP_DOMAIN).$(APP_NAME)
INFOPLIST_FILE = Resources/colir-Info.plist

//Signing
CODE_SIGN_ENTITLEMENTS = Configurations/entitlement.entitlements
ENABLE_HARDENED_RUNTIME = YES

//Deployment
COMBINE_HIDPI_IMAGES = YES
DEVELOPMENT_ASSET_PATHS = "Resources/Preview Content"

//Asset Catalog Compiler - Options
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

//Localization
SWIFT_EMIT_LOC_STRINGS = YES

//Info.plist Values
INFOPLIST_KEY_NSPhotoLibraryUsageDescription = Choice photo to draw on folder
INFOPLIST_KEY_CFBundleDisplayName = Colir
