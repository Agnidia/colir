//Build Options
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES

//Localization
SWIFT_EMIT_LOC_STRINGS = NO

//Packaging
PRODUCT_BUNDLE_IDENTIFIER = $(APP_DOMAIN).$(APP_NAME)UITest

//User-Defined
TEST_TARGET_NAME = $(APP_NAME)
