    "%@, %lld emojis, %@" : {
      "comment" : "A label describing a group of emojis, including the number of emojis it contains and whether it is currently expanded or collapsed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld emojis, %3$@"
          }
        }
      }
    },
    "%@, %lld items" : {
      "comment" : "A label that describes the number of items in a list. The argument is the list name, and the second argument is the number of items.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld items"
          }
        }
      }
    },
    "%@, %lld shades, %@" : {
      "comment" : "A label describing a color group, including the number of shades and whether it is expanded or collapsed. The first argument is the name of the color group. The second argument is the count of its shades. The third argument describes whether the group is expanded or collapsed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld shades, %3$@"
          }
        }
      }
    },
    "%@%@, %@" : {
      "comment" : "A toggle that can be expanded or collapsed. The first argument is the name of the expandable section. The second argument is whether the section is currently expanded or collapsed. The third argument is the number of items in the expandable section (if available).",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@, %3$@"
          }
        }
      }
    },
    "%lld shades" : {
      "comment" : "A text label that shows the number of color shades in a group. The argument is the number of colors in the group.",
      "isCommentAutoGenerated" : true
