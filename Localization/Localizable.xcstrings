    "alert.purchase.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "our team always tries to keep the developed products in good condition so that they can help you for longer.\n\n\nDo you want to thank the developer?\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "наша команда завжди намагається підтримувати розроблені продукти у гарному стані, щоб вони довще вам допомогали. \n\n\nВи хочете подякувати розробника?\n"
          }
        }
      }
    },
